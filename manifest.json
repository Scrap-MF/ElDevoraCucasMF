{
  "manifest_version": 3,
  "name": "ElDevoraCucas",
  "version": "0.1.0",
  "description": "Export cookies for scrapmf-supported networks as a Netscape cookies.txt file.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "cookies",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://*.tiktok.com/*",
    "*://tiktok.com/*",
    "*://*.twitter.com/*",
    "*://twitter.com/*",
    "*://*.x.com/*",
    "*://x.com/*",
    "*://*.vsco.co/*",
    "*://vsco.co/*",
    "*://*.threads.com/*",
    "*://threads.com/*",
    "*://*.threads.net/*",
    "*://threads.net/*",
    "*://*.facebook.com/*",
    "*://facebook.com/*",
    "*://*.fb.com/*",
    "*://fb.com/*",
    "*://m.facebook.com/*"
  ],
  "action": {
    "default_title": "ElDevoraCucas",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "eldevoracucas@mfapplications",
      "strict_min_version": "109.0"
    },
    "gecko_android": {}
  },
  "options_page": "options/options.html",
  "background": {
    "scripts": [
      "lib/cookies.js",
      "background.js"
    ]
  },
  "commands": {
    "download-cookies": {
      "suggested_key": {
        "default": "Ctrl+Shift+F12"
      },
      "description": "Download scrapmf cookies"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "*://*.tiktok.com/*",
        "*://tiktok.com/*",
        "*://*.twitter.com/*",
        "*://twitter.com/*",
        "*://*.x.com/*",
        "*://x.com/*",
        "*://*.vsco.co/*",
        "*://vsco.co/*",
        "*://*.threads.com/*",
        "*://threads.com/*",
        "*://*.threads.net/*",
        "*://threads.net/*",
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "*://*.fb.com/*",
        "*://fb.com/*",
        "*://m.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
